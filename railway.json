{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn --cwd pos-app install --frozen-lockfile && yarn --cwd pos-app prisma generate"
  },
  "deploy": {
    "startCommand": "yarn --cwd pos-app dev:socket",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
