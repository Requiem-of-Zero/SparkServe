{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd pos-app && npm install --include=dev && npm exec prisma generate"
  },
  "deploy": {
    "startCommand": "cd pos-app && npm run start:socket",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
